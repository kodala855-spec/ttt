# Telegram API credentials (obtain from https://my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+1234567890

# OpenAI API configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Userbot behavior settings
RESPONSE_CHANCE=0.15
TYPING_MIN_DELAY=1.0
TYPING_MAX_DELAY=3.0
TYPO_CHANCE=0.10
CASUAL_SUFFIX_CHANCE=0.20

# Do Not Disturb hours (24-hour format, leave empty to disable)
DND_START=23:00
DND_END=08:00

# Media paths (relative to project root)
PHOTOS_DIR=media/photos
VIDEO_NOTES_DIR=media/video_notes
STICKERS_FILE=stickers.json

# Safety and rate limiting
MAX_MESSAGE_LENGTH=4096
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW=60
MIN_RESPONSE_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=userbot.log

# Database
DB_FILE=history.db
