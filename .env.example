# Telegram API credentials (https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here
OWNER_ID=123456789

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
SYSTEM_PROMPT=You are a casual, friendly Telegram user. Keep replies short, natural, and human.
AI_TIMEOUT=30

# History
HISTORY_LIMIT=14
DB_PATH=chat_history.db

# Do Not Disturb
DND_START=23:00
DND_END=08:00
DND_MODE=sleepy

# Safety
SAFETY_AUTO_PAUSE=true

# Behavior tuning
TYPING_MIN_DELAY=0.6
TYPING_MAX_DELAY=4.5
TYPO_PROBABILITY=0.08

# Logging
LOG_FILE=userbot.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# Media
PHOTOS_DIR=media/photos
VIDEO_NOTES_DIR=media/video_notes
STICKERS_FILE=stickers.json
