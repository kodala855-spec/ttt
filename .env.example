# Telegram API credentials (get from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+1234567890

# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Owner Telegram user ID (get from @userinfobot)
OWNER_ID=your_telegram_user_id

# Do Not Disturb hours (24-hour format HH:MM)
DND_START=23:00
DND_END=08:00

# AI configuration
SYSTEM_PROMPT=You are a helpful assistant having a casual conversation. Keep responses natural, concise, and friendly.
AI_TIMEOUT=30
HISTORY_LIMIT=10

# Database and files
DB_PATH=chat_history.db
STICKERS_FILE=stickers.json

# Media directories
PHOTOS_DIR=media/photos
VIDEO_NOTES_DIR=media/video_notes
