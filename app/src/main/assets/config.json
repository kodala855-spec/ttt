{
  "kiosk": {
    "url": "https://example.com/kiosk",
    "exitTapCount": 5,
    "exitGestureEnabled": true,
    "gestureThreshold": 3
  },
  "security": {
    "hideStatusBar": true,
    "disableNotifications": false,
    "lockTaskMode": true
  },
  "appearance": {
    "backgroundColor": "#000000",
    "textColor": "#FFFFFF",
    "edgeToEdge": true
  },
  "features": {
    "autoReload": true,
    "reloadOnNetworkChange": true,
    "offlineMessage": "No internet connection"
  }
}
